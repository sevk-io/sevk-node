{
  "name": "sevk",
  "version": "1.1.0",
  "description": "Node.js SDK for Sevk API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Sevk <dev@sevk.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sevk-io/sevk-node"
  },
